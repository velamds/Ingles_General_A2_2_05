ype": "text", "content": ""}], "id": 0, "selected": 0}]}], "stimuli_ids": [], "id": 11, "type": "DWS", "_data": [{"type": "instructions", "contents": [{"type": "text", "content": " Imagine you are a tourist in the Middle East. "}]}, {"type": "group", "contents": [{"type": "group_name", "content": "Take Away"}]}, {"type": "feedback", "content": {"allowed_attempts": 2, "correct_feedback": "Correct!", "attempt_feedback": [{"type": "text", "content": ""}, {"type": "text", "content": ""}], "incorrect_feedback": [{"type": "text", "content": "Whoops! Something important is missing."}, {"type": "text", "content": "Maybe next time..."}]}}, {"type": "learning_skills", "contents": [{"type": "skill", "content": "Reading"}, {"type": "skill", "content": "Writing"}, {"type": "skill", "content": "Speaking"}]}, {"type": "post_instructions", "contents": [{"type": "text", "content": "Instructions: Complete the following steps. Fill in the Self Assessment."}]}], "template_override": 1}], "id": 0, "type": "scholar", "stimuli": [{"id": 0, "_data": [], "template_override": 1, "type": "welcome", "contents": [{}]}, {"id": 3, "type": "audio", "title": "", "_data": [], "template_override": 1, "contents": [{"type": "slideshow", "value": {"audiosrc": "engenn5le05ob08re2aud01", "coverimg": "engenn5le05ob08re2img05.jpg", "images": [{"text": "", "id": 0, "time": "0", "image": "engenn5le05ob08re2img05.jpg"}, {"text": "<span class=\"strong\">Peter</span>: Nice photos! Can you tell me where Petra is again?</br>\n<span class=\"strong\">Sally</span>: It lies in a basin along the mountains in southern Jordan.</br>\n<span class=\"strong\">Peter</span>: The monastery and treasury are carved out of stone, right?</br>\n<span class=\"strong\">Sally</span>:  Yes, it's incredible!", "id": 1, "time": "100", "image": "engenn5le05ob08re2img05.jpg"}, {"text": "<span class=\"strong\">Peter</span>: How far is it from the town center?</br>\n<span class=\"strong\">Sally</span>: It's a 20 minute walk through the desert.  You can ride a camel, donkey or horse around the area.</br>\n<span class=\"strong\">Peter</span>: Wow, I'm missing out on a lot.</br>\n<span class=\"strong\">Sally</span>:  It'll be 2050 before you get to travel.", "id": 2, "time": "14000", "image": "engenn5le05ob08re2img03.jpg"}, {"text": "<span class=\"strong\">Peter</span>: I have to work, remember? Maybe I might go to Petra in May, after I save enough money.</br>\n<span class=\"strong\">Sally</span>: Ah, but this year the holy fast of Ramadan is in May. During this month, Muslims mustn't eat, drink, or smoke during the day.", "id": 3, "time": "30000", "image": "engenn5le05ob08re2img05.jpg"}, {"text": "<span class=\"strong\">Peter</span>: And tourists?</br>\n<span class=\"strong\">Sally</span>: Tourists mustn't eat, drink, or smoke in public places.</br>\n<span class=\"strong\">Peter</span>: I may go in June instead.", "id": 4, "time": "45500", "image": "engenn5le05ob08re2img05.jpg"}]}}]}]}], "_data": [{"type": "metadata", "contents": [{"type": "lesson_name", "content": "Sally on the Aegean Sea"}, {"type": "unit_name", "content": "Petra"}, {"type": "position", "content": 8}, {"type": "origin", "content": "scholar > Taking a Break > Dead Sea"}, {"type": "lesson", "content": 5}, {"type": "level", "content": "A2.2"}]}, {"type": "achievment_test", "contents": [{"type": "test", "content": "false"}]}, {"type": "objectives", "contents": [{"type": "primary", "content": "Accurately use information about people's jobs and places of work in communicative situations."}, {"type": "secondary_1", "content": "Understands important information and aspects of attitude and intention in spoken situations in English on a range of common communicative topics related to this level. "}, {"type": "secondary_2", "content": "Identifies the expressions and vocabulary necessary for the description of places of work and jobs in common written and spoken situations. "}, {"type": "secondary_3", "content": "Identifies the expressions and vocabulary necessary for the description of places of work and jobs in common written and spoken situations. "}, {"type": "secondary_4", "content": "Understands important information and aspects of attitude and intention in spoken situations in English on a range of common communicative topics related to this level. "}, {"type": "secondary_5", "content": "Understands important information and aspects of attitude and intention in spoken situations in English on a range of common communicative topics related to this level. "}, {"type": "secondary_6", "content": "Understands important information and aspects of attitude and intention in spoken situations in English on a range of common communicative topics related to this level. "}, {"type": "secondary_7", "content": "Understands important information and aspects of attitude and intention in spoken situations in English on a range of common communicative topics related to this level."}, {"type": "secondary_8", "content": "Understands important information and aspects of attitude and intention in spoken situations in English on a range of common communicative topics related to this level. "}]}, {"type": "background_image", "content": "engenn5le05ob08re1img01.jpg"}, {"type": "learning_points", "contents": [{"type": "heading", "content": "Ask and Say Where Places Are"}, {"type": "describer", "content": " "}, {"type": "text", "content": "Here are some example questions and answers."}, {"type": "table", "content": "{\"rows\":8,\"columns\":2,\"cells\":[\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"Ask Where Places Are\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"Say Where Places Are\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"Can you tell me where the monastery is?\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"It's about a twenty minute walk east of here.\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"Could you tell me where the donkeys are?\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"They are tied up near the hotel.\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"I'd like to know where the ticket office is.\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"It's across the road from the restaurant.\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"Could anyone tell me where to find the tourist office?\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"It's in the centre of town.\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"I don't suppose you would know where the tour starts?\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"It starts in the entrance hall.\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"I wonder if you could tell me where I can get a souvenir?\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"The souvenir shop is down the street.\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"Would you happen to know where I could find a bathroom?\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"The public bathrooms are inside the building.\\\"}\"],\"styles\":\" intro_table_border instruction_table_background\"}"}]}, {"type": "target_word", "contents": [{"type": "name", "content": "basin"}, {"type": "definition", "content": "a large area of the earth's surface that is lower than the area around it "}, {"type": "part_speech", "content": "(noun)"}, {"type": "example", "content": "Example: Petra is is located in a large basin."}, {"type": "audio", "content": "engenn5le05ob08aud01"}]}, {"type": "target_word_describer", "contents": [{"type": "text", "content": "These are words you use to describe Petra."}]}, {"type": "target_word", "contents": [{"type": "name", "content": "treasury"}, {"type": "definition", "content": "the place where a government keeps its money"}, {"type": "part_speech", "content": "(noun)"}, {"type": "example", "content": "Example: The treasury building is stunning."}, {"type": "audio", "content": "engenn5le05ob08aud02"}]}, {"type": "target_word", "contents": [{"type": "name", "content": "to fast"}, {"type": "definition", "content": "to eat no food for a period of time"}, {"type": "part_speech", "content": "(verb)"}, {"type": "example", "content": "Example: Muslims fast during Ramadan."}, {"type": "audio", "content": "engenn5le05ob08aud03"}]}, {"type": "target_word", "contents": [{"type": "name", "content": "Ramadan"}, {"type": "definition", "content": "a time when Muslims refrain from consuming food, drinking liquids and smoking in the daytime"}, {"type": "part_speech", "content": "(noun)"}, {"type": "example", "content": "Example: Ramadan happens once a year."}, {"type": "audio", "content": "engenn5le05ob08aud04"}]}, {"type": "target_word", "contents": [{"type": "name", "content": "Muslim"}, {"type": "definition", "content": "a follower of the religion of Islam"}, {"type": "part_speech", "content": "(noun)"}, {"type": "example", "content": "Example: Muslims often make a pilgrimage to Mecca."}, {"type": "audio", "content": "engenn5le05ob08aud05"}]}, {"type": "target_word", "contents": [{"type": "name", "content": "to smoke"}, {"type": "definition", "content": "to suck the smoke from a cigarette"}, {"type": "part_speech", "content": "(verb)"}, {"type": "example", "content": "Example: Muslims do not smoke during Ramadan."}, {"type": "audio", "content": "engenn5le05ob08aud06"}]}, {"type": "takeaway_extension", "contents": [{"type": "text", "content": "Research the city of Petra in Jordan."}, {"type": "text", "content": "Write a paragraph that describes what you see."}, {"type": "text", "content": "Use paragraph structure."}, {"type": "text", "content": "Use adjectives to make your ideas come alive!"}, {"type": "text", "content": "Read your paragraph to a partner."}]}, {"type": "takeaway_assessment", "contents": [{"type": "text", "content": "I research famous ancient cities."}, {"type": "text", "content": "I write a paragraph on Petra."}, {"type": "text", "content": "I proofread my work."}, {"type": "text", "content": "I read my paragraph aloud."}]}], "type": "sena"}