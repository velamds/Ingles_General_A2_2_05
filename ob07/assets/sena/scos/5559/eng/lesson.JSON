{"labs": [{"id": 0, "type": "scholar", "stimuli": [{"_data": [], "type": "welcome", "contents": [{}], "template_override": 1, "id": 0}, {"id": 1, "title": "", "contents": [{"value": {"images": [{"text": "", "id": 0, "time": "0", "image": "engenn5le05ob07re2img06.jpg"}, {"text": "<span class=\"strong\">Sally</span>: Peter! How are you! </br>\n<span class=\"strong\">Peter</span>: Great, Sally! Where are you now?</br>\n<span class=\"strong\">Sally</span>: I'm in Jordan.</br>\n<span class=\"strong\">Peter</span>: Will you visit Petra?</br>\n<span class=\"strong\">Sally</span>: Yes! I'm going tomorrow.</br>\n<span class=\"strong\">Peter</span>: What do you know about it?</br>\n<span class=\"strong\">Sally</span>:  It's rose-colored! The buildings are carved into the canyon walls!", "id": 1, "time": "100", "image": "engenn5le05ob07re2img06.jpg"}, {"text": "<span class=\"strong\">Peter</span>: How will you get there?</br>\n<span class=\"strong\">Sally</span>:  It's in a long, winding sandstone canyon along the east side of the valley. You ride or walk in between the rock walls. I'll go at 5 a.m. and rent a horse.</br>\n<span class=\"strong\">Peter</span>: So early!</br>\n<span class=\"strong\">Sally</span>: It will get hot.</br>\n<span class=\"strong\">Peter</span>: What will you see?", "id": 2, "time": "17000", "image": "engenn5le05ob07re2img01.jpg"}, {"text": "<span class=\"strong\">Sally</span>: I'll visit tombs, an amphitheater, a monastery and a treasury to start.</br>\n<span class=\"strong\">Peter</span>: It sounds exciting.</br>\n<span class=\"strong\">Sally</span>: I'm getting up at 3:30, so I have to go to bed now!</br>\n<span class=\"strong\">Peter</span>: Take lots of pictures!</br>\n<span class=\"strong\">Sally</span>: I will!", "id": 3, "time": "35000", "image": "engenn5le05ob07re2img05.jpg"}], "audiosrc": "engenn5le05ob07re2aud01", "coverimg": "engenn5le05ob07re2img06.jpg"}, "type": "slideshow"}], "_data": [], "type": "audio", "template_override": 1}], "exerc